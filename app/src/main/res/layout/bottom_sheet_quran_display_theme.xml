    <!--        android:id="@+id/view_text_size_separator"-->
    <!--        android:layout_width="0dp"-->
    <!--        android:layout_height="1dp"-->
    <!--        android:layout_marginTop="@dimen/_12sdp"-->
    <!--        android:background="@color/secondary_color"-->
