<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">


    <Transition
        android:id="@+id/transition"
        motion:duration="300"
        motion:autoTransition="jumpToStart"
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start">
        <OnSwipe
            motion:dragDirection="dragRight"
            motion:touchAnchorId="@id/img_animated_move"
            motion:touchAnchorSide="right" />
        <KeyFrameSet>
            <KeyAttribute
                android:translationX="35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_top_counter_two" />

            <KeyAttribute
                android:translationX="35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_top_counter_one" />

            <KeyAttribute
                android:translationX="35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_top_counter_zero" />

            <KeyAttribute
                android:translationX="35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_bottom_counter" />

            <KeyAttribute
                android:translationX="35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_bottom_count_counter" />

        </KeyFrameSet>
    </Transition>


    <Transition
        android:id="@+id/transition1"
        motion:constraintSetEnd="@+id/end1"
        motion:constraintSetStart="@+id/start1"
        motion:duration="350"
        motion:autoTransition="jumpToStart"
        >
        <OnSwipe
            motion:dragDirection="dragLeft"
            motion:touchAnchorId="@id/img_animated_move"
            motion:touchAnchorSide="left" />
        <KeyFrameSet>
            <KeyAttribute
                android:translationX="-35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_top_counter_two" />

            <KeyAttribute
                android:translationX="-35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_top_counter_one" />

            <KeyAttribute
                android:translationX="-35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_top_counter_zero" />
            <KeyAttribute
                android:translationX="-35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_bottom_counter" />

            <KeyAttribute
                android:translationX="-35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_bottom_count_counter" />

            <KeyAttribute
                android:translationX="-35dp"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_bottom_counter_zero" />
            <KeyAttribute
                android:alpha="0.0"
                motion:framePosition="1"
                motion:motionTarget="@+id/img_bottom_count_counter" />

            <KeyAttribute
                android:alpha="0.0"
                motion:framePosition="100"
                motion:motionTarget="@+id/img_bottom_count_counter" />

        </KeyFrameSet>
    </Transition>


    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/img_animated_move"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            motion:layout_constraintBottom_toBottomOf="@+id/img_top_counter_two"
            motion:layout_constraintStart_toEndOf="@+id/img_top_counter_two"
            motion:layout_constraintTop_toTopOf="@+id/img_top_counter_two" />


    </ConstraintSet>

    <ConstraintSet
        android:id="@+id/end"
        motion:deriveConstraintsFrom="@id/start">

        <Constraint android:id="@id/img_animated_move">
            <Layout
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                motion:layout_constraintBottom_toBottomOf="@+id/img_bottom_count_counter"
                motion:layout_constraintEnd_toStartOf="@+id/img_bottom_counter"
                motion:layout_constraintTop_toTopOf="@+id/img_bottom_count_counter" />

        </Constraint>
    </ConstraintSet>


    <ConstraintSet android:id="@+id/start1">
        <Constraint android:id="@id/img_animated_move">
            <Layout
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                motion:layout_constraintBottom_toBottomOf="@+id/img_bottom_count_counter"
                motion:layout_constraintEnd_toStartOf="@+id/img_bottom_counter"
                motion:layout_constraintTop_toTopOf="@+id/img_bottom_count_counter" />

        </Constraint>

        <Constraint android:id="@+id/img_top_counter_zero">
            <Layout
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                motion:layout_constraintBottom_toBottomOf="@+id/img_top_counter_one"
                motion:layout_constraintEnd_toStartOf="@+id/img_top_counter_one"
                motion:layout_constraintTop_toTopOf="@+id/img_top_counter_one" />

        </Constraint>


    </ConstraintSet>

    <ConstraintSet
        android:id="@+id/end1"
        motion:deriveConstraintsFrom="@id/start1">

        <Constraint android:id="@id/img_animated_move">
            <Layout
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                motion:layout_constraintBottom_toBottomOf="@+id/img_top_counter_one"
                motion:layout_constraintStart_toEndOf="@+id/img_top_counter_one"
                motion:layout_constraintTop_toTopOf="@+id/img_top_counter_one" />

        </Constraint>
    </ConstraintSet>
</MotionScene>